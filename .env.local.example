# ---------------------------------------------------------------------------
# SajiloKaam environment
#
# Copy to `.env.local` for local development:
#     cp .env.local.example .env.local
#
# `.env.local` is gitignored and must never be committed. The same values go
# into Vercel → Settings → Environment Variables for deployments.
# ---------------------------------------------------------------------------

# --- Supabase -------------------------------------------------------------
# Supabase dashboard → your project → Project Settings → API (or "API Keys").

# Project URL. Looks like https://abcdefghijklm.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Publishable key (`sb_publishable_...`) from the same page. Safe in the
# browser — row level security is what protects the data, not this key.
#
# Supabase now issues two kinds of browser key: the modern publishable key and
# the older "anon" JWT. Either works here; prefer publishable, which rotates
# independently of the project's JWT secret. The variable keeps the ANON_KEY
# name because every Supabase guide and template refers to it that way.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# "service_role" / "secret" key. SERVER ONLY — bypasses row level security.
# Never prefix this with NEXT_PUBLIC_ and never import it into a Client
# Component. In Vercel, scope it so it is not exposed to the browser bundle.
SUPABASE_SERVICE_ROLE_KEY=

# --- Anthropic (Claude) ---------------------------------------------------
# console.anthropic.com → API keys. Used from Phase 4 for problem triage.
# Server only.
ANTHROPIC_API_KEY=

# --- Site ------------------------------------------------------------------
# The public origin, with no trailing slash. Drives Open Graph previews and
# every absolute URL the app emits, so a wrong value means every shared link
# advertises the wrong domain.
#
# Set this in Vercel → Production. Preview deployments fall back to Vercel's
# own NEXT_PUBLIC_VERCEL_URL, and a fresh clone falls back to localhost.
NEXT_PUBLIC_SITE_URL=https://sewasathi.vercel.app

# --- Payments --------------------------------------------------------------
# All optional. With none of them set the product still works: cash is a
# first-class payment method, not a fallback, and a gateway with no credentials
# is hidden from the customer rather than shown and then failing after they
# have committed.
#
# Sandbox credentials for both are free and take minutes:
#   eSewa  — developer.esewa.com.np → "ePay v2" → test credentials. The
#            published sandbox pair below is eSewa's own, documented, and safe
#            to use; it moves no real money.
#   Khalti — dev.khalti.com → sign up as a merchant → Keys → "Live Secret Key"
#            (their sandbox calls it that; it is the test key).

# eSewa ePay v2. Server only — the secret signs the payment form.
# Sandbox values, straight from eSewa's own documentation:
#   ESEWA_PRODUCT_CODE=EPAYTEST
#   ESEWA_SECRET_KEY=8gBm/:&EnhH.1/q
ESEWA_PRODUCT_CODE=
ESEWA_SECRET_KEY=
# "live" switches to the production endpoints. Anything else means sandbox,
# which is the safe default — a typo cannot accidentally take real money.
ESEWA_ENV=sandbox

# Khalti KPG-2. Server only. Amounts cross the wire in paisa; that conversion
# lives in lib/payments/khalti.ts and nowhere else.
KHALTI_SECRET_KEY=
KHALTI_ENV=sandbox

# --- Health check ----------------------------------------------------------
# A number you own, in E.164. When set, GET /api/health?deep=1 asks Supabase to
# actually send an OTP to it and reports what the gateway said — the only way
# to know the SMS credentials are real. Point it at a Supabase *test* number
# (Authentication -> Providers -> Phone -> Test phone numbers) and it costs
# nothing to run as often as you like, while still proving the whole path.
#
# Without it that check reports "skipped", never "ok": not looking must never
# read as working. Sign-in was broken in production for a day because it did.
SMS_HEALTH_NUMBER=

# --- Cron ------------------------------------------------------------------
# Shared secret for GET /api/payments/reconcile, which re-verifies payments
# that started and never came back — the dropped-connection case, which is
# routine on Nepali mobile data. Any long random string; set the same value in
# Vercel → Settings → Cron Jobs. With it unset the endpoint refuses every
# request rather than running open.
CRON_SECRET=
